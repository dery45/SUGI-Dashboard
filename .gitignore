node_modules/
dist/
dist-ssr/
*.local
.env
.env.*
!backend/.env.example
.DS_Store
.vscode/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore .kilo directory
.kilo/

# Ignore the testing folder (Playwright suites, reports, artifacts)
testing/

# Ignore all markdown files except README.md at root and docs/CHANGELOG.md + docs/VERSION.md
*.md
!/README.md
!/docs/CHANGELOG.md
!/docs/VERSION.md

# Ignore the rest of docs/ (phase & architecture documents, HTML guides), keep backend/docs
docs/*
!docs/CHANGELOG.md
!docs/VERSION.md
!backend/docs/

# Generated structure maps
BACKEND_STRUCTURE.md
FRONTEND_STRUCTURE.md